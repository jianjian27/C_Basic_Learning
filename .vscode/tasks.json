
{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "C: Build active file",
            "type": "shell",
            "command": "D:\\mingw64\\bin\\gcc.exe",
            "args": [
                "-g",
                "-O0",
                "${file}",
                "-o",
                "${fileDirname}\\${fileBasenameNoExtension}.exe"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}
